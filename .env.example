# Copy to .env and fill in local values. Never commit .env.

# development serves frontend/public at http://localhost:8000
ENVIRONMENT=development

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=ariseto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ariseto
POSTGRES_PORT=5432

# Backend (port must match POSTGRES_PORT)
DATABASE_URL=postgresql+psycopg://ariseto:change-me@localhost:5432/ariseto
TEST_DATABASE_URL=postgresql+psycopg://ariseto:change-me@localhost:5432/ariseto_test

# JWT signing key: a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenWeatherMap key for the backend weather fetch (never sent to the browser).
# Leave empty to run without weather; fetching then reports that the key is missing.
OPENWEATHERMAP_API_KEY=

# Disease detection model (TensorFlow, from the optional "ml" extra: pip install -e "backend[ml]").
# Leave any of these empty to run without it; POST /diagnoses then answers 503 model_unavailable.
# DISEASE_MODEL_PATH is a .keras file, DISEASE_LABELS_PATH a labels.json list in output order,
# DISEASE_CONFIDENCE_THRESHOLD a number from 0 to 1 chosen by the model team.
DISEASE_MODEL_PATH=
DISEASE_LABELS_PATH=
DISEASE_MODEL_VERSION=
DISEASE_CONFIDENCE_THRESHOLD=
# Folder for the leaf photos (default backend/var/leaf_images); never committed.
LEAF_IMAGE_DIR=
