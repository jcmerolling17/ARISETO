# Copy to .env and fill in local values. Never commit .env.

# development serves frontend/public at http://localhost:8000
ENVIRONMENT=development

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=ariseto
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ariseto
POSTGRES_PORT=5432

# Backend (port must match POSTGRES_PORT)
DATABASE_URL=postgresql+psycopg://ariseto:change-me@localhost:5432/ariseto
TEST_DATABASE_URL=postgresql+psycopg://ariseto:change-me@localhost:5432/ariseto_test

# JWT signing key: a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
